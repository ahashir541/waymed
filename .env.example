# Copy to .env and fill in. Never commit .env.
# Port the server listens on.
PORT=8080
# SQLite file location (directory must exist and be writable, back it up daily).
DATABASE_PATH=./data/waymed.db
# Long random string used to sign staff session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me
# Public origin used in QR codes and for the CSRF origin check, e.g. https://waymed.example.org
PUBLIC_ORIGIN=http://localhost:8080
# Set to "production" behind HTTPS so cookies are Secure.
NODE_ENV=development
# First admin, created automatically on first start when no staff accounts exist (hosted deploys).
# Remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: Gemini API key for the talkative assistant. Without it the assistant uses rule-based answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Enables the "Simulate queue" button on /staff. Leave false in production.
DEMO_TOOLS=false
# Hours that tokens, events, guide requests and appointments are kept (privacy rule: 24).
RETENTION_HOURS=24
# Optional error tracking endpoint (e.g. a Sentry/GlitchTip DSN) for the client error hook.
VITE_ERROR_DSN=
